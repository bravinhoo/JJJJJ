    <script>
        // Tab Navigation
        function showTab(tabName) {
            const tabs = document.querySelectorAll('.tab-content');
            const buttons = document.querySelectorAll('[id^="btn-"]');
            
            tabs.forEach(tab => tab.classList.add('hidden'));
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white');
                btn.classList.add('bg-white', 'text-gray-700');
            });
            
            document.getElementById('tab-' + tabName).classList.remove('hidden');
            document.getElementById('btn-' + tabName).classList.remove('bg-white', 'text-gray-700');
            document.getElementById('btn-' + tabName).classList.add('bg-blue-600', 'text-white');
        }

        // Dynamic Fields
        function addObjective() {
            const list = document.getElementById('objectives-list');
            const div = document.createElement('div');
            div.className = 'flex gap-2 mb-2';
            div.innerHTML = `
                <input type="text" placeholder="Objetivo ${list.children.length + 1}" class="flex-1 p-3 border-2 border-gray-200 rounded-lg focus:border-green-500 outline-none objective-input">
                <button onclick="this.parentElement.remove()" class="px-3 bg-red-500 text-white rounded hover:bg-red-600">❌</button>
            `;
            list.appendChild(div);
        }

